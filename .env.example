# Copy to .env and fill in. Never commit the filled copy — .gitignore and
# .dockerignore both exclude it, so it also never reaches the image.
#
# Two groups, and they are used by different things:
#
#   - the application reads DATABASE_URL and AUTH_SECRET only;
#   - the PG* variables are for the scripts (db:migrate, db:test, db:seed) and
#     for the e2e suite, which talk to psql and pg directly.
#
# On the production server this file lives beside
# docker-compose.production.yml, in DEPLOY_PATH, and only the first group is
# strictly required there.

# ---------------------------------------------------------------- database

DATABASE_URL=postgres://user:password@host:5432/fieldbook

PGHOST=localhost
PGPORT=5432
PGUSER=fieldbook
PGPASSWORD=
PGDATABASE=fieldbook

# ------------------------------------------------------------------- auth

# Generate with: openssl rand -base64 32
#
# It must stay the same across deploys. Changing it invalidates every session
# token in existence, which signs out everybody, and there is no warning —
# people simply find themselves at the sign-in page (spec 08 §3).
AUTH_SECRET=

# Required when the app runs behind a reverse proxy rather than on Vercel:
# without it Auth.js refuses to trust the forwarded host and sign-in fails.
AUTH_TRUST_HOST=true

# Host port the container publishes to. Production compose only; defaults to 3000.
APP_PORT=3000

# ---------------------------------------------------------------- clickup

# Only for the one-off extraction scripts. Not needed to run the product, and
# not needed on the server at all.
CLICKUP_TOKEN=
CLICKUP_TEAM_ID=
# Optional absolute path for private document images; defaults to data/doc-assets.
DOC_ASSET_DIR=
