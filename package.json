{
  "name": "fieldbook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:build": "node --env-file=.env scripts/psql.mjs db/schema.sql",
    "db:test": "node --env-file=.env scripts/psql.mjs db/tests.sql",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "node --env-file=.env scripts/seed.mjs",
    "clickup:extract": "node --env-file=.env scripts/clickup-extract.mjs",
    "clickup:load": "node scripts/clickup-load.mjs",
    "test": "node --test tests/*.test.ts",
    "check": "npm run typecheck && npm run test",
    "test:e2e": "node --env-file=.env --test tests/e2e/api.test.ts tests/e2e/tree.test.ts tests/e2e/admin.test.ts tests/e2e/password.test.ts tests/e2e/roster.test.ts tests/e2e/profile.test.ts",
    "test:acceptance": "node --env-file=.env --test tests/e2e/acceptance.test.ts",
    "test:docs": "node --env-file=.env --test tests/e2e/docs.test.ts",
    "test:docs-browser": "node --env-file=.env --test tests/e2e/doc-editor.browser.test.ts",
    "clickup:diff": "node scripts/clickup-diff.mjs",
    "db:load": "node --env-file=.env scripts/psql.mjs"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/extension-task-item": "^3.31.3",
    "@tiptap/extension-task-list": "^3.31.3",
    "@tiptap/markdown": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@xmldom/xmldom": "^0.8.15",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "mammoth": "^1.12.2",
    "next": "^16.3.4",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.9.0"
  }
}
