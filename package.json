{
  "name": "fieldbook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3010",
    "build": "next build",
    "start": "next start --port 3010",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:build": "node --env-file=.env scripts/psql.mjs db/schema.sql",
    "db:test": "node --env-file=.env scripts/psql.mjs db/tests.sql",
    "db:migrate": "node --env-file=.env scripts/migrate.mjs",
    "db:seed": "node --env-file=.env scripts/seed.mjs",
    "clickup:extract": "node --env-file=.env scripts/clickup-extract.mjs",
    "clickup:load": "node scripts/clickup-load.mjs",
    "test": "node --test tests/*.test.ts",
    "check": "npm run typecheck && npm run test",
    "test:e2e": "node --env-file=.env --test tests/e2e/api.test.ts tests/e2e/tree.test.ts tests/e2e/admin.test.ts tests/e2e/password.test.ts tests/e2e/roster.test.ts tests/e2e/profile.test.ts tests/e2e/notifications.test.ts tests/e2e/default-columns.test.ts",
    "test:acceptance": "node --env-file=.env --test tests/e2e/acceptance.test.ts",
    "test:wiki": "node --env-file=.env --test --test-concurrency=1 tests/e2e/wiki.test.ts tests/e2e/wiki.browser.test.ts tests/e2e/wiki-mcp.test.ts tests/e2e/wiki-mcp-write.test.ts tests/e2e/wiki-guide.test.ts",
    "test:docs": "node --env-file=.env --test tests/e2e/docs.test.ts",
    "test:mcp": "node --env-file=.env --test --test-concurrency=1 tests/e2e/tokens.test.ts tests/e2e/tokens.browser.test.ts tests/e2e/mcp-list.test.ts tests/e2e/mcp-docs.test.ts tests/e2e/access-token-migration.test.ts",
    "test:docs-browser": "node --env-file=.env --test tests/e2e/doc-editor.browser.test.ts tests/e2e/doc-mermaid.browser.test.ts",
    "test:calendar-look": "node --env-file=.env --test tests/e2e/calendar-look.browser.test.ts",
    "test:defects": "node --env-file=.env --test tests/e2e/defects.test.ts tests/e2e/defects.browser.test.ts tests/e2e/list-loading.test.mjs tests/e2e/list-edit.browser.test.ts tests/e2e/list-lazy.browser.test.ts tests/e2e/list-filter.browser.test.ts",
    "clickup:diff": "node scripts/clickup-diff.mjs",
    "db:load": "node --env-file=.env scripts/psql.mjs",
    "prepare": "husky",
    "audit": "npm audit --audit-level=high --omit=dev"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/anuphan": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/extension-task-item": "^3.31.3",
    "@tiptap/extension-task-list": "^3.31.3",
    "@tiptap/markdown": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@xmldom/xmldom": "^0.8.15",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.17",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.70.0",
    "mammoth": "^1.12.2",
    "mermaid": "^12.3.0",
    "next": "^16.3.4",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.23.0",
    "radix-ui": "^1.8.1",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.0"
  }
}
