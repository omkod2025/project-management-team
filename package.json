{
  "name": "fieldbook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:build": "node --env-file=.env scripts/psql.mjs db/schema.sql",
    "db:test": "node --env-file=.env scripts/psql.mjs db/tests.sql",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "node --env-file=.env scripts/seed.mjs",
    "clickup:extract": "node --env-file=.env scripts/clickup-extract.mjs",
    "clickup:load": "node scripts/clickup-load.mjs",
    "test": "node --test tests/*.test.ts",
    "check": "npm run typecheck && npm run test",
    "test:e2e": "node --env-file=.env --test tests/e2e/api.test.ts tests/e2e/tree.test.ts tests/e2e/admin.test.ts",
    "test:acceptance": "node --env-file=.env --test tests/e2e/acceptance.test.ts",
    "clickup:diff": "node scripts/clickup-diff.mjs",
    "db:load": "node --env-file=.env scripts/psql.mjs"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "next": "^16.3.4",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.9.0"
  }
}